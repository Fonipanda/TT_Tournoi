# ============================================================================
# TT Tournoi — Variables d'environnement
# ----------------------------------------------------------------------------
# Copier ce fichier en .env (dev local) ou configurer ces variables dans
# Coolify > Application > Environment Variables (production).
# Marquer comme "secret" toutes les variables *_SECRET, *_KEY, *_TOKEN.
# ============================================================================

# ----- Database (PostgreSQL 16) -----
DATABASE_URL=postgresql://tt:tt@localhost:5432/tt_tournoi?schema=public
SHADOW_DATABASE_URL=postgresql://tt:tt@localhost:5432/tt_tournoi_shadow?schema=public

# ----- Redis 7 (cache + Pub/Sub + BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Auth JWT (changer impérativement en prod, 32+ caractères aléatoires) -----
JWT_ACCESS_SECRET=changeme-access-secret-please-use-at-least-32-characters-long-random
JWT_REFRESH_SECRET=changeme-refresh-secret-different-from-access-32-chars-min-random
# Défauts du code si non définies : 15m / 7d. Ne pas allonger sans raison.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ----- SMTP (emails transactionnels : mot de passe oublié) -----
# Si SMTP_HOST est vide, aucun email n'est envoyé : le contenu est simplement
# journalisé dans la console (pratique en développement).
# OVH mutualisé : SMTP_HOST=ssl0.ovh.net / SMTP_PORT=465 / SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TT Tournoi <no-reply@tournoi-chellestt.fr>

# ----- URL publiques (front + WS) -----
# Dev local : utiliser localhost. En production : voir DEPLOIEMENT.md
# Prod cible : NEXT_PUBLIC_APP_URL=https://tournoi-chellestt.fr
# Prod cible : NEXT_PUBLIC_WS_URL=wss://tournoi-chellestt.fr/ws/api/ws/live
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws/live

# ----- Service Fastify WebSocket -----
WS_PORT=3001
WS_INTERNAL_TOKEN=changeme-token-partage-entre-web-et-ws-pour-publish-securisé

# ----- API FFTT (lookup licence + cache) -----
FFTT_API_BASE=http://fftt.dafunker.com/v1
FFTT_CACHE_TTL=86400

# ----- OVH SMS Pro (ADAPTATEUR ACTIF EN V1) -----
# Obtenir les clés via https://api.ovh.com/createToken
OVH_SMS_APP_KEY=
OVH_SMS_APP_SECRET=
OVH_SMS_CONSUMER_KEY=
OVH_SMS_SERVICE_NAME=sms-xxxxx-1
OVH_SMS_DEFAULT_SENDER=ChellesTT

# ----- Twilio (DESACTIVE V1, configuration optionnelle) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----- Free Mobile (DESACTIVE V1, pour tests perso) -----
FREE_MOBILE_USER=
FREE_MOBILE_PASS=

# ----- Backup PostgreSQL → Object Storage OVH -----
S3_BACKUP_BUCKET=tt-tournoi-backups
S3_BACKUP_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BACKUP_REGION=gra

# ----- Niveau de logs -----
LOG_LEVEL=info
NODE_ENV=development
