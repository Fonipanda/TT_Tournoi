# =============================================================================
# pnpm config
# =============================================================================
# Hoist les paquets natifs/externalisés à la racine de /node_modules pour
# que Next.js standalone (résolution Node standard) puisse les trouver au
# runtime via require('argon2'), require('@prisma/client'), etc.
# Ces paquets sont marqués comme `serverExternalPackages` dans next.config.mjs
# donc Next ne les bundle pas et compte les trouver dans node_modules au run.
# =============================================================================

public-hoist-pattern[]=argon2
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=prisma
