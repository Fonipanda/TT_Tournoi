{
  "name": "@tt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.js"
  },
  "scripts": {
    "build": "echo 'no build (consumed via TypeScript path)'",
    "lint": "echo 'no lint'",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf src/generated dist .turbo",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@tt/config": "workspace:*",
    "argon2": "^0.41.1",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
