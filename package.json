{
  "name": "tt-tournoi",
  "version": "2.0.0-dev",
  "private": true,
  "description": "TT Tournoi — Plateforme de gestion de tournois de tennis de table (Chelles TT). Mono-repo Next.js 15 + Fastify WS + PostgreSQL + Redis.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tt/e2e test:e2e",
    "test:e2e:install": "pnpm --filter @tt/e2e test:e2e:install",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,prisma}\"",
    "db:generate": "pnpm --filter @tt/db prisma generate",
    "db:migrate": "pnpm --filter @tt/db prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @tt/db prisma migrate deploy",
    "db:seed": "pnpm --filter @tt/db seed",
    "db:studio": "pnpm --filter @tt/db prisma studio",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": ["prettier-plugin-prisma"]
  }
}
